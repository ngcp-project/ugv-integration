<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="file:////home/ugv/rti_connext_dds-rpi/resource/schema/rti_dds_qos_profiles.xsd">

    <qos_library name="ugv_Library">

        <qos_profile name="ugv_Profile" base_name="BuiltinQosLib::Generic.StrictReliable" is_default_qos="true">

            <datawriter_qos>
                <publication_name>
                    <name>ugvDataWriter</name>
                </publication_name>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>32</depth>
                </history>
                <resource_limits>
                    <max_samples>64</max_samples>
                    <max_instances>1</max_instances>
                    <max_samples_per_instance>64</max_samples_per_instance>
                </resource_limits>
                <durability>
                    <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
                </durability>
            </datawriter_qos>

            <datareader_qos>
                <subscription_name>
                    <name>ugvDataReader</name>
                </subscription_name>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>32</depth>
                </history>
                <resource_limits>
                    <max_samples>64</max_samples>
                    <max_instances>1</max_instances>
                    <max_samples_per_instance>64</max_samples_per_instance>
                </resource_limits>
                <durability>
                    <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
                </durability>
            </datareader_qos>

            <domain_participant_qos>
                <participant_name>
                    <name>ugvParticipant</name>
                    <role_name>ugvParticipantRole</role_name>
                </participant_name>
                <discovery>
                    <initial_peers>
                        <element>10.110.148.25</element> <!-- Jetson Orin Nano (Eduroam) -->
                        <element>10.110.171.170</element> <!-- Chris's MacBook (Eduroam) -->
                        <element>192.168.1.165</element> <!-- Jetson Orin Nano (Local) -->
                        <element>192.168.1.157</element> <!-- Chris's Mac (Local) -->
                    </initial_peers>
                </discovery>
            </domain_participant_qos>

        </qos_profile>

    </qos_library>

</dds>
